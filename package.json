{
  "name": "frameforge",
  "version": "1.0.0",
  "description": "HyperFrames-based AI Video Studio - MVP",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run serve --workspace=apps/render-worker",
    "dev:all": "node scripts/dev-all.js",
    "build": "npm run build --workspaces --if-present",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "render-worker": "npm run start --workspace=apps/render-worker"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "author": "FrameForge Team",
  "license": "MIT"
}
